# Claude Usage Dashboard — environment template.
# Copy to .env (which is gitignored) and fill in real values:
#     cp .env.example .env
# The app reads these from the process environment; in production hand them to
# gunicorn via systemd's EnvironmentFile=/.../.env (KEY=value lines, no quotes,
# no `export`). See README "Configuration".

# --- Required: the app fails closed and refuses to start without these two ---

# Flask session signing key. Generate:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
FLASK_SECRET_KEY=replace-me-with-a-long-random-hex

# Dashboard login password.
DASHBOARD_PASSWORD=replace-me-with-a-strong-password

# --- Required to add accounts: Fernet key encrypting OAuth tokens at rest ---
# Losing this key means re-adding every account. Generate:
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=replace-me-with-a-fernet-key

# --- Optional (shown with their defaults) ---

# Login username.
DASHBOARD_USERNAME=admin

# Set to 1 when served over HTTPS so the session cookie gets the Secure flag.
SESSION_COOKIE_SECURE=1

# Days of history to keep; older snapshots/quotas and data/ files are pruned daily.
RETENTION_DAYS=60

# Local dev escape hatch ONLY: allow the built-in default secret/password so the
# app will boot without the two required vars above. NEVER set this in production.
# ALLOW_DEFAULT_CREDENTIALS=1

# --- Advanced: leave unset unless you know you need to override a code default ---
# These override OAuth client id / User-Agent values used against Anthropic's
# endpoints. The defaults baked into api_usage_fetcher.py are the ones that work;
# set these only to debug. Values intentionally omitted here (see the code for the
# working defaults) so this template carries no high-entropy strings.
# CLAUDE_OAUTH_CLIENT_ID=
# CLAUDE_CLI_VERSION=
# TOKEN_ENDPOINT_UA=
# FLASK_DEBUG=0
